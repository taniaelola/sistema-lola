{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sistema-lola",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sistema-lola"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://lolaonline.com.br",
    "NEXT_PUBLIC_SUPABASE_URL": "https://uqfhbtkwnmksbtmkdcop.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_8rH-RhrIRJ5RnA6nYFXPdg_x6FC9wRl"
  },
  "observability": {
    "enabled": true
  }
}
